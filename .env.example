# Local environment for `pnpm dev`, `node apps/web/dist/cli.mjs serve|migrate|scheduler`,
# `pnpm seed:fixtures` and `pnpm linear:sync`. Copy it to `.env` at the root of the main
# checkout; mise.toml loads that one file into every worktree's shell. Never commit `.env`
# and never reuse a production value here. docs/deploy.md, "Local development", explains
# each step; "Environment" there is the full contract.

# The Postgres of compose.yaml (`pnpm db:up`). `pnpm dev` and the tests fall back to it;
# the built CLI's serve, migrate and scheduler need it set.
DATABASE_URL=postgres://linear:linear@localhost:55432/linear

# Where the browser reaches the server; the OAuth callback derives from it.
PUBLIC_URL=http://localhost:3000

# The development OAuth app, not the production one: callback
# http://localhost:3000/auth/linear/callback, client credentials enabled, webhooks off.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Required by `serve`, unused locally: no tunnel means no webhook deliveries.
# Any value without whitespace, e.g. `openssl rand -hex 32`.
LINEAR_WEBHOOK_SECRET=

# `openssl rand -base64 32` for each. Changing TOKEN_ENCRYPTION_KEY signs you out and makes
# the next scheduler pass request a new app token.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Your Linear email, so only you can sign in to the local server.
SIGNIN_ALLOWLIST=

# Personal API key for `pnpm seed:fixtures` and `pnpm linear:sync`; not read by the server.
# LINEAR_API_KEY=
