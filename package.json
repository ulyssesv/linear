{
  "name": "linear-sesv",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "dev": "pnpm --filter @sesv/web run dev",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "pnpm --filter @sesv/web --if-present run test:e2e",
    "test:smoke": "pnpm --filter @sesv/web run test:smoke",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "check:specs": "pnpm --filter @sesv/specs run check:specs",
    "linear:sync": "pnpm --filter @sesv/specs run linear:sync",
    "seed:fixtures": "pnpm --filter @sesv/seed run seed:fixtures",
    "smoke:container": "bash tools/container-smoke.sh",
    "db:up": "docker compose up --detach --wait postgres",
    "db:down": "docker compose down",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:specs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
